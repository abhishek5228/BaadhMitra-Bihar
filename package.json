{
  "name": "baadhmitra",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless vernacular flood-rescue triage for Bihar: Hindi voice/text distress reports to ranked rescue incidents on AWS.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "vite --config web/vite.config.ts web",
    "web:build": "vite build --config web/vite.config.ts web",
    "synth": "cdk synth --quiet",
    "deploy": "npm run web:build && cdk deploy --require-approval never",
    "eval": "tsx eval/run.ts",
    "eval:ind": "tsx eval/score.ts",
    "feed:check": "tsx scripts/feed-check.ts",
    "villages": "tsx scripts/villages.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "docs:data": "tsx scripts/docs-data.ts",
    "docs:graphs": "python3 scripts/docs-graphs.py"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-polly": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-transcribe": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "aws-cdk": "^2.1000.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.24.0",
    "three": "^0.170.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
